{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEventBridgeToPublishOnly",
      "Effect": "Allow",
      "Principal": { "Service": "events.amazonaws.com" },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:REGION:ACCOUNT_ID:migration-alerts",
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:events:REGION:ACCOUNT_ID:rule/high-risk-migration-alert"
        }
      }
    }
  ]
}
