{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "MigrationIntakeRequest",
  "type": "object",
  "properties": {
    "migrationId": {
      "type": "string",
      "pattern": "^MIG-[0-9]{4,}$"
    },
    "answers": {
      "type": "object",
      "properties": {
        "oracleVersion": { "type": "string", "enum": ["A", "B", "C"] },
        "databaseSize": { "type": "string", "enum": ["A", "B", "C"] },
        "downtimeTolerance": { "type": "string", "enum": ["A", "B", "C"] },
        "architecture": { "type": "string", "enum": ["A", "B", "C"] },
        "specialFeatures": { "type": "string", "enum": ["A", "B", "C"] },
        "externalDependencies": { "type": "string", "enum": ["A", "B", "C"] },
        "sensitiveDataStatus": { "type": "string", "enum": ["A", "B", "C"] },
        "targetReadiness": { "type": "string", "enum": ["A", "B", "C"] }
      },
      "required": [
        "oracleVersion",
        "databaseSize",
        "downtimeTolerance",
        "architecture",
        "specialFeatures",
        "externalDependencies",
        "sensitiveDataStatus",
        "targetReadiness"
      ]
    }
  },
  "required": ["migrationId", "answers"]
}
